{
  "name": "UserBlock",
  "type": "object",
  "properties": {
    "blocker_id": {
      "type": "string",
      "description": "User who initiated the block"
    },
    "blocked_id": {
      "type": "string",
      "description": "User who was blocked"
    },
    "blocked_name": {
      "type": "string",
      "description": "Display name of blocked user at time of block"
    }
  },
  "required": [
    "blocker_id",
    "blocked_id"
  ]
}