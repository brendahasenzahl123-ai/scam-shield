{
  "name": "PostComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "author_name": {
      "type": "string"
    },
    "helpful_votes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "post_id",
    "content"
  ]
}